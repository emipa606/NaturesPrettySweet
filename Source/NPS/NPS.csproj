<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputPath>..\..\1.6\Assemblies</OutputPath>
    <TargetFramework>net48</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>None</DebugType>
    <LangVersion>latest</LangVersion>
    <FileVersion>1.6.11</FileVersion>
    <AssemblyVersion>1.6</AssemblyVersion>
    <Product>Nature's Pretty Sweet (Continued)</Product>
    <Copyright>© tkkntkkn 2026 - MIT License</Copyright>
    <Nullable>warnings</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref">
      <Version>*</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony">
      <Version>3.0.0-rc.2</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Mlie_Rimworld_VersionFromManifest" Version="*" />
  </ItemGroup>
	<Target Name="KillRimWorld" BeforeTargets="Clean;Build">
		<Exec Command='tasklist /FI "IMAGENAME eq RimWorld.exe" | find /I "RimWorld.exe" &gt;nul &amp;&amp; taskkill /F /IM RimWorld.exe' IgnoreExitCode="true" />
	</Target>
</Project>